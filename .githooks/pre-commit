#!/bin/sh
set -eu

branch="$(git branch --show-current)"
case "$branch" in
    ai-dev|ai-main|codex/ai-*)
        git_exec_path="${GIT_EXEC_PATH:-}"
        if [ -n "$git_exec_path" ]; then
            case "${PATH-}" in
                "$git_exec_path":*)
                    if [ "$(git --exec-path)" = "$git_exec_path" ]; then
                        # Git prepends its exec directory for hooks; keep phase execution and receipt PATHs aligned.
                        PATH="${PATH#"$git_exec_path":}"
                        export PATH
                    fi
                    ;;
            esac
        fi
        exec "${PYTHON:-python3}" script/ai_commit.py precommit
        ;;
esac
