{
  "schema_version": 2,
  "task_id": "MC-AI-0249",
  "rows": [
    {
      "id": "macos_asan",
      "label": "macOS AddressSanitizer with integrated LeakSanitizer",
      "platform": "macos",
      "capability": "clang-address-sanitizer",
      "flags": ["-DCMAKE_BUILD_TYPE=Release", "-DMC_ENABLE_HIGH_ASSERT=OFF", "-DMC_ENABLE_SANITIZERS=ON", "-DMC_SANITIZER=address"],
      "compile_commands": "build/analysis-macos-asan/compile_commands.json",
      "required_compile_flags": ["-fsanitize=address"],
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1",
        "LSAN_OPTIONS": "suppressions={env:MC_ANALYSIS_ROOT}/script/ci/macos_lsan.supp:print_suppressions=1"
      },
      "tool_probes": [["python", "--version"], ["clang", "--version"], ["clang++", "--version"], ["cmake", "--version"]],
      "commands": [
        ["python", "script/ci/verify_macos_lsan.py", "controls", "--build-dir", "build/analysis-macos-asan/lsan-controls"],
        ["cmake", "--preset", "analysis-macos-asan"],
        ["cmake", "--build", "--preset", "analysis-macos-asan"],
        ["ctest", "--test-dir", "build/analysis-macos-asan", "--output-on-failure", "--no-tests=error"],
        ["python", "script/ci/verify_macos_lsan.py", "summarize", "--last-test-log", "build/analysis-macos-asan/Testing/Temporary/LastTest.log"]
      ],
      "timeout_seconds": 900
    },
    {
      "id": "macos_ubsan",
      "label": "macOS UndefinedBehaviorSanitizer",
      "platform": "macos",
      "capability": "clang-undefined-behavior-sanitizer",
      "flags": ["-DCMAKE_BUILD_TYPE=Release", "-DMC_ENABLE_HIGH_ASSERT=OFF", "-DMC_ENABLE_SANITIZERS=ON", "-DMC_SANITIZER=undefined"],
      "compile_commands": "build/analysis-macos-ubsan/compile_commands.json",
      "required_compile_flags": ["-fsanitize=undefined"],
      "environment": {"UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"},
      "tool_probes": [["clang", "--version"], ["cmake", "--version"]],
      "commands": [["cmake", "--preset", "analysis-macos-ubsan"], ["cmake", "--build", "--preset", "analysis-macos-ubsan"], ["ctest", "--test-dir", "build/analysis-macos-ubsan", "--output-on-failure", "--no-tests=error"]],
      "timeout_seconds": 900
    },
    {
      "id": "macos_tsan",
      "label": "macOS ThreadSanitizer",
      "platform": "macos",
      "capability": "clang-thread-sanitizer",
      "flags": ["-DCMAKE_BUILD_TYPE=Release", "-DMC_ENABLE_HIGH_ASSERT=OFF", "-DMC_ENABLE_SANITIZERS=ON", "-DMC_SANITIZER=thread"],
      "compile_commands": "build/analysis-macos-tsan/compile_commands.json",
      "required_compile_flags": ["-fsanitize=thread"],
      "tool_probes": [["clang", "--version"], ["cmake", "--version"]],
      "commands": [["cmake", "--preset", "analysis-macos-tsan"], ["cmake", "--build", "--preset", "analysis-macos-tsan"], ["ctest", "--test-dir", "build/analysis-macos-tsan", "--output-on-failure", "--no-tests=error"]],
      "timeout_seconds": 900
    },
    {
      "id": "windows_msvc_asan",
      "label": "Windows MSVC AddressSanitizer",
      "platform": "windows",
      "capability": "msvc-address-sanitizer",
      "flags": ["-DCMAKE_BUILD_TYPE=Release", "-DMC_ENABLE_HIGH_ASSERT=OFF", "-DMC_ENABLE_SANITIZERS=ON", "-DMC_SANITIZER=address", "/fsanitize=address"],
      "compile_commands": "build/analysis-windows-asan/compile_commands.json",
