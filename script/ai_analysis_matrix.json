      "platform": "windows",
      "capability": "msvc-analyze",
      "flags": ["/analyze", "/W4", "/WX"],
      "tool_probes": [["cl.exe", "/Bv", "/?"], ["cmake", "--version"]],
      "commands": [["cmake", "--preset", "analysis-windows-analyze"], ["cmake", "--build", "--preset", "analysis-windows-analyze"], ["ctest", "--test-dir", "build/analysis-windows-analyze", "--output-on-failure", "--no-tests=error"]],
      "timeout_seconds": 1200
    },
    {
      "id": "linux_lsan",
      "label": "Linux standalone LeakSanitizer",
      "platform": "linux",
      "analysis_only": true,
      "capability": "clang-leak-sanitizer",
      "flags": ["-DCMAKE_BUILD_TYPE=Release", "-DMC_ENABLE_HIGH_ASSERT=OFF", "-DMC_ANALYSIS_HOST=ON", "-DMC_BUILD_CLIENT=OFF", "-DMC_ENABLE_SANITIZERS=ON", "-DMC_SANITIZER=leak", "-DVCPKG_TARGET_TRIPLET={env:MC_ANALYSIS_LINUX_LSAN_TRIPLET}", "-fsanitize=leak"],
      "compile_commands": "build/analysis-linux-lsan/compile_commands.json",
      "required_compile_flags": ["-fsanitize=leak"],
      "environment": {"LSAN_OPTIONS": "exitcode=23:print_suppressions=0"},
      "tool_probes": [["clang++", "--version"], ["cmake", "--version"], ["ninja", "--version"]],
      "commands": [
        ["cmake", "--preset", "analysis-linux-lsan", "-DCMAKE_TOOLCHAIN_FILE={env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake", "-DVCPKG_INSTALLED_DIR={env:VCPKG_INSTALLED_DIR}", "-DVCPKG_TARGET_TRIPLET={env:MC_ANALYSIS_LINUX_LSAN_TRIPLET}", "-DCMAKE_PREFIX_PATH={env:MC_PRIVATE_DEPENDENCIES_PREFIX}", "-DCoreCpp_DIR={env:MC_PRIVATE_DEPENDENCIES_PREFIX}/lib/cmake/CoreCpp", "-DCoreProject2026_DIR={env:MC_PRIVATE_DEPENDENCIES_PREFIX}/lib/cmake/CoreProject2026"],
        ["cmake", "--build", "--preset", "analysis-linux-lsan", "--verbose"],
        ["ctest", "--test-dir", "build/analysis-linux-lsan", "--output-on-failure", "--no-tests=error", "--timeout", "60"]
      ],
      "timeout_seconds": 3600
    },
    {
      "id": "linux_msan",
      "label": "Linux MemorySanitizer with upstream instrumented libc++",
      "platform": "linux",
      "analysis_only": true,
      "capability": "clang-memory-sanitizer",
      "flags": ["-DCMAKE_BUILD_TYPE=Release", "-DMC_ENABLE_HIGH_ASSERT=OFF", "-DMC_ANALYSIS_HOST=ON", "-DMC_BUILD_CLIENT=OFF", "-DMC_ENABLE_SANITIZERS=ON", "-DMC_SANITIZER=memory", "-DVCPKG_TARGET_TRIPLET={env:MC_ANALYSIS_LINUX_MSAN_TRIPLET}", "-fsanitize=memory", "-fsanitize-memory-track-origins=2", "-stdlib=libc++", "LLVM_USE_SANITIZER=MemoryWithOrigins"],
      "compile_commands": "build/analysis-linux-msan/compile_commands.json",
      "required_compile_flags": ["-fsanitize=memory", "-fsanitize-memory-track-origins=2", "-stdlib=libc++"],
      "environment": {"MSAN_OPTIONS": "halt_on_error=1:print_stats=1:fast_unwind_on_fatal=1", "DEBUGINFOD_URLS": ""},
      "tool_probes": [["clang", "--version"], ["clang++", "--version"], ["cmake", "--version"], ["ninja", "--version"], ["git", "-C", "{env:MC_LLVM_PROJECT_ROOT}", "rev-parse", "HEAD"], ["ldd", "--version"]],
      "commands": [
        ["cmake", "--preset", "analysis-linux-msan", "-DCMAKE_TOOLCHAIN_FILE={env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake", "-DVCPKG_INSTALLED_DIR={env:VCPKG_INSTALLED_DIR}", "-DVCPKG_TARGET_TRIPLET={env:MC_ANALYSIS_LINUX_MSAN_TRIPLET}", "-DCMAKE_PREFIX_PATH={env:MC_PRIVATE_DEPENDENCIES_PREFIX}", "-DCoreCpp_DIR={env:MC_PRIVATE_DEPENDENCIES_PREFIX}/lib/cmake/CoreCpp", "-DCoreProject2026_DIR={env:MC_PRIVATE_DEPENDENCIES_PREFIX}/lib/cmake/CoreProject2026"],
        ["cmake", "--build", "--preset", "analysis-linux-msan", "--verbose"],
        ["ctest", "--test-dir", "build/analysis-linux-msan", "--output-on-failure", "--no-tests=error", "--timeout", "60"]
      ],
      "timeout_seconds": 3600
    },
    {
      "id": "clang_static_analysis",
      "label": "Clang static analyzer",
      "platform": "macos",
      "capability": "clang-analyzer",
      "flags": ["scan-build interposition", "-Xanalyzer", "-analyzer-output=text"],
      "tool_probes": [["clang", "--version"], ["scan-build", "--help"]],
      "commands": [["cmake", "--preset", "analysis-clang-static"], ["cmake", "--build", "--preset", "analysis-clang-static"]],
      "timeout_seconds": 900
    },
    {
      "id": "clang_tidy",
      "label": "clang-tidy",
      "platform": "macos",
      "capability": "clang-tidy",
      "flags": ["--checks=bugprone-*,performance-*", "--warnings-as-errors=*"],
      "tool_probes": [["clang-tidy", "--version"]],
      "commands": [["cmake", "--preset", "analysis-clang-tidy"], ["cmake", "--build", "--preset", "analysis-clang-tidy"]],
      "timeout_seconds": 900
    },
    {
      "id": "iwyu",
      "label": "Include What You Use",
      "platform": "macos",
      "capability": "include-what-you-use",
      "flags": [
        "CMAKE_CXX_INCLUDE_WHAT_YOU_USE=python3;${sourceDir}/script/ci/iwyu_gate.py;--;include-what-you-use;-Xiwyu;--no_fwd_decls;-Xiwyu;--error;--",
        "CMake -Xiwyu --error suffix propagates wrapper failures and is stripped before the actual IWYU subprocess",
        "owned public include additions fail; removals, private SDK includes, and forward-declaration suggestions are reported"
      ],
      "tool_probes": [["include-what-you-use", "--version"]],
      "commands": [["cmake", "--preset", "analysis-iwyu"], ["cmake", "--build", "--preset", "analysis-iwyu"]],
      "timeout_seconds": 900
    },
    {
      "id": "cppcheck",
      "label": "cppcheck",
      "platform": "macos",
      "capability": "cppcheck",
      "flags": [
        "CMAKE_CXX_COMPILER_LAUNCHER=python3;${sourceDir}/script/ci/cppcheck_gate.py;--;cppcheck;--enable=all;--inline-suppr;--xml;--",
        "CMAKE_C_CPPCHECK=;CMAKE_CXX_CPPCHECK= (disable stale built-in checker cache entries)",
        "error, warning, performance, and portability diagnostics fail; style, information, and debug diagnostics are reported; uninitMemberVarNoCtor and passedByValue are excluded"
      ],
      "tool_probes": [["cppcheck", "--version"]],
      "commands": [["cmake", "--preset", "analysis-cppcheck"], ["cmake", "--build", "--preset", "analysis-cppcheck"]],
