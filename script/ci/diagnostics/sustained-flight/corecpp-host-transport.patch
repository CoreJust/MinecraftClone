+struct ChannelCommandCounts final {
+    uint64_t channel0 = 0U;
+    uint64_t channel1 = 0U;
+    uint64_t other = 0U;
+};
+
+template<typename NativeCommand>
+[[nodiscard]]
+ChannelCommandCounts countCommands(ENetList& commands) noexcept
+{
+    ChannelCommandCounts counts;
+    for (ENetListNode* node = enet_list_begin(&commands);
+         node != enet_list_end(&commands);
+         node = enet_list_next(node)) {
+        auto const* const command = reinterpret_cast<NativeCommand const*>(node);
+        switch (command->command.header.channelID) {
+            case 0U:
+                ++counts.channel0;
+                break;
+            case 1U:
+                ++counts.channel1;
+                break;
+            default:
+                ++counts.other;
+                break;
+        }
+    }
+    return counts;
+}
+
+[[nodiscard]]
+bool transportDiagnosticsEnabled() noexcept
+{
+    char const* const value = std::getenv("CORECPP_ENET_DIAGNOSTICS");
+    return value != nullptr && std::string_view{value} == "1";
+}
+
+void logTransportSnapshots(ENetHost& host, uint64_t const host_id, int64_t const elapsed_ms)
+{
+    for (uint64_t peer_index = 0U; peer_index < static_cast<uint64_t>(host.peerCount); ++peer_index) {
+        ENetPeer& peer = host.peers[peer_index];
+        if (peer.state != ENET_PEER_STATE_CONNECTED || peer.channels == nullptr) {
+            continue;
+        }
+
+        auto const sent_reliable = countCommands<ENetOutgoingCommand>(peer.sentReliableCommands);
+        auto const queued_reliable = countCommands<ENetOutgoingCommand>(peer.outgoingSendReliableCommands);
+        auto const queued_commands = countCommands<ENetOutgoingCommand>(peer.outgoingCommands);
+        auto const dispatched = countCommands<ENetIncomingCommand>(peer.dispatchedCommands);
+        ChannelCommandCounts ordered_incoming;
+        for (uint64_t channel_index = 0U;
+             channel_index < static_cast<uint64_t>(peer.channelCount);
+             ++channel_index) {
+            auto const channel_commands = countCommands<ENetIncomingCommand>(
+                peer.channels[channel_index].incomingReliableCommands
+            );
+            ordered_incoming.channel0 += channel_commands.channel0;
+            ordered_incoming.channel1 += channel_commands.channel1;
+            ordered_incoming.other += channel_commands.other;
+        }
+
+        CORE_INFO(
+            "ENet transport host={} elapsed={}ms peer={} remote-port={} reliable-window={}/{} "
+            "rtt-ms={}/{}/{} loss={}/{} packets-sent/lost={}/{} throttle={}/{} waiting-data={} "
+            "sent-reliable(channel0/channel1/other)={}/{}/{} queued-reliable={}/{}/{} queued-all={}/{}/{} "
+            "dispatched(channel0/channel1/other)={}/{}/{} ordered-incoming={}/{}/{}",
+            host_id,
+            elapsed_ms,
+            peer_index,
+            peer.address.port,
+            peer.reliableDataInTransit,
+            peer.windowSize,
+            peer.lastRoundTripTime,
+            peer.roundTripTime,
+            peer.roundTripTimeVariance,
+            peer.packetLoss,
+            static_cast<uint32_t>(ENET_PEER_PACKET_LOSS_SCALE),
+            peer.packetsSent,
+            peer.packetsLost,
+            peer.packetThrottle,
+            peer.packetThrottleLimit,
+            peer.totalWaitingData,
+            sent_reliable.channel0,
+            sent_reliable.channel1,
+            sent_reliable.other,
+            queued_reliable.channel0,
+            queued_reliable.channel1,
+            queued_reliable.other,
+            queued_commands.channel0,
+            queued_commands.channel1,
+            queued_commands.other,
+            dispatched.channel0,
+            dispatched.channel1,
+            dispatched.other,
+            ordered_incoming.channel0,
+            ordered_incoming.channel1,
+            ordered_incoming.other
+        );
+    }
+}
