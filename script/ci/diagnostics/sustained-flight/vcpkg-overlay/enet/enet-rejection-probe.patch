+static void
+enet_protocol_record_rejection (ENetProtocolRejectionProbe * probe, ENetPeer * peer,
+                                 ENetOutgoingCommand * outgoingCommand,
+                                 enet_uint32 throttledWindowSize, enet_uint16 reliableWindow,
+                                 enet_uint32 previousReliableWindowCount,
+                                 enet_uint32 usedReliableWindows)
+{
+   ENetProtocolRejectionSnapshot snapshot;
+
+   snapshot.channelID = outgoingCommand -> command.header.channelID;
+   snapshot.command = outgoingCommand -> command.header.command & ENET_PROTOCOL_COMMAND_MASK;
+   snapshot.reliableSequenceNumber = outgoingCommand -> reliableSequenceNumber;
+   snapshot.sendAttempts = outgoingCommand -> sendAttempts;
+   snapshot.fragmentNumber = snapshot.command == ENET_PROTOCOL_COMMAND_SEND_FRAGMENT ?
+                             ENET_NET_TO_HOST_32 (outgoingCommand -> command.sendFragment.fragmentNumber) : 0;
+   snapshot.fragmentOffset = outgoingCommand -> fragmentOffset;
+   snapshot.fragmentLength = outgoingCommand -> fragmentLength;
+   snapshot.reliableDataInTransit = peer -> reliableDataInTransit;
+   snapshot.peerWindowSize = peer -> windowSize;
+   snapshot.throttledWindowSize = throttledWindowSize;
+   snapshot.effectiveWindowSize = ENET_MAX (throttledWindowSize, peer -> mtu);
+   snapshot.packetThrottle = peer -> packetThrottle;
+   snapshot.mtu = peer -> mtu;
+   snapshot.reliableWindow = reliableWindow;
+   snapshot.previousReliableWindowCount = previousReliableWindowCount;
+   snapshot.usedReliableWindows = usedReliableWindows;
+
+   if (snapshot.channelID == 0 && probe -> channel0Count != 0xFFFFFFFF)
+     ++ probe -> channel0Count;
+   if (probe -> count == 0)
+     probe -> first = snapshot;
+   probe -> last = snapshot;
+   if (probe -> count != 0xFFFFFFFF)
+     ++ probe -> count;
+}
+
 size_t
