diff --git a/libunwind/src/CMakeLists.txt b/libunwind/src/CMakeLists.txt
--- a/libunwind/src/CMakeLists.txt
+++ b/libunwind/src/CMakeLists.txt
@@ -25,7 +25,14 @@
 set(LIBUNWIND_ASM_SOURCES
     UnwindRegistersRestore.S
     UnwindRegistersSave.S
     )
+if (CMAKE_SYSTEM_NAME STREQUAL "Linux"
+    AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$"
+    AND LLVM_USE_SANITIZER MATCHES "^Memory(WithOrigins)?$")
+  set_property(SOURCE UnwindRegistersSave.S APPEND PROPERTY COMPILE_DEFINITIONS
+    _LIBUNWIND_MSAN_X86_64
+  )
+endif()
-
+
 set(LIBUNWIND_HEADERS
     AddressSpace.hpp
diff --git a/libunwind/src/UnwindRegistersSave.S b/libunwind/src/UnwindRegistersSave.S
--- a/libunwind/src/UnwindRegistersSave.S
+++ b/libunwind/src/UnwindRegistersSave.S
@@ -126,4 +126,11 @@
   movdqu %xmm15,416(PTR)
 #endif
+#if defined(_LIBUNWIND_MSAN_X86_64) && defined(__linux__) && defined(__x86_64__)
+  // The 17 saved qwords stop at RIP; skipped flags and segments stay poisoned.
+  subq  $8, %rsp
+  movq  $136, %rsi
+  call  __msan_unpoison
+  addq  $8, %rsp
+#endif
   xorl  %eax, %eax    # return UNW_ESUCCESS
   ret

diff --git a/libunwind/src/AddressSpace.hpp b/libunwind/src/AddressSpace.hpp
--- a/libunwind/src/AddressSpace.hpp
+++ b/libunwind/src/AddressSpace.hpp
@@ -603,6 +603,13 @@
   // support for _dl_find_object on other unwind formats is not implemented,
   // yet.
 #if defined(DLFO_STRUCT_HAS_EH_DBASE) & defined(_LIBUNWIND_SUPPORT_DWARF_INDEX)
+// MSan intercepts dl_iterate_phdr, but not glibc's _dl_find_object.
+#if defined(__has_feature)
+#if __has_feature(memory_sanitizer)
+#define _LIBUNWIND_MSAN_USE_DL_ITERATE_PHDR
+#endif
+#endif
+#if !defined(_LIBUNWIND_MSAN_USE_DL_ITERATE_PHDR)
   // We expect `_dl_find_object` to return PT_GNU_EH_FRAME.
 #if DLFO_EH_SEGMENT_TYPE != PT_GNU_EH_FRAME
 #error _dl_find_object retrieves an unexpected section type
@@ -650,7 +657,9 @@
     info.dwarf_section_length = SIZE_MAX;
     return true;
   }
 #endif
+#endif
+#undef _LIBUNWIND_MSAN_USE_DL_ITERATE_PHDR
   dl_iterate_cb_data cb_data = {this, &info, targetAddr};
   int found = dl_iterate_phdr(findUnwindSectionsByPhdr, &cb_data);
   return static_cast<bool>(found);
