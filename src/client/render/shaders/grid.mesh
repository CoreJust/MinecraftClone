#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;

layout(max_vertices = 4, max_primitives = 2) out;
layout(triangles) out;

layout(push_constant) uniform PushConstants {
    float world_size;
    float line_width;
    float pad0;
    float pad1;
    vec4  line_color;
} pc;

layout(location = 0) out vec4 outColor[];

vec2 worldToNdc(vec2 p) {
    return vec2(
        (p.x / pc.world_size) * 2.0 - 1.0,
        (p.y / pc.world_size) * 2.0 - 1.0
    );
}

void main() {
    SetMeshOutputsEXT(4, 2);

    float x = float(gl_WorkGroupID.x);
    float y = float(gl_WorkGroupID.y);

    vec2 c00 = vec2(x,     y);
    vec2 c10 = vec2(x + 1, y);
    vec2 c01 = vec2(x,     y + 1);
    vec2 c11 = vec2(x + 1, y + 1);

    vec2 inset = vec2(pc.line_width * 0.5);
    vec2 p0 = c00 + inset;
    vec2 p1 = c10 + vec2(-inset.x,  inset.y);
    vec2 p2 = c01 + vec2( inset.x, -inset.y);
    vec2 p3 = c11 - inset;

    gl_MeshVerticesEXT[0].gl_Position = vec4(worldToNdc(p0), 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(worldToNdc(p1), 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(worldToNdc(p2), 0.0, 1.0);
    gl_MeshVerticesEXT[3].gl_Position = vec4(worldToNdc(p3), 0.0, 1.0);

    outColor[0] = pc.line_color;
    outColor[1] = pc.line_color;
    outColor[2] = pc.line_color;
    outColor[3] = pc.line_color;

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(2, 1, 3);
}
