#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;

layout(max_vertices = 4, max_primitives = 2) out;
layout(triangles) out;

layout(push_constant) uniform PushConstants {
    float worldSize;
    float lineWidth;
    float pad0;
    float pad1;
    vec4 lineColor;
} pc;

layout(location = 0) out vec4 outColor[];

vec2 worldToNdc(vec2 p) {
    vec2 ndc;
    ndc.x = (p.x / 32.0) * 2.0 - 1.0;
    ndc.y = (p.y / 32.0) * 2.0 - 1.0;
    return ndc;
}

void main() {
    SetMeshOutputsEXT(4, 2);

    float x = float(gl_WorkGroupID.x);
    float y = float(gl_WorkGroupID.y);

    vec2 p0 = worldToNdc(vec2(x,     y));
    vec2 p1 = worldToNdc(vec2(x + 1, y));
    vec2 p2 = worldToNdc(vec2(x,     y + 1));
    vec2 p3 = worldToNdc(vec2(x + 1, y + 1));

    gl_MeshVerticesEXT[0].gl_Position = vec4(p0, 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(p1, 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(p2, 0.0, 1.0);
    gl_MeshVerticesEXT[3].gl_Position = vec4(p3, 0.0, 1.0);

    vec4 c = (((uint(x) + uint(y)) & 1u) == 0u)
        ? vec4(0.12, 0.12, 0.14, 1.0)
        : vec4(0.14, 0.14, 0.16, 1.0);

    outColor[0] = c;
    outColor[1] = c;
    outColor[2] = c;
    outColor[3] = c;

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(2, 1, 3);
}
