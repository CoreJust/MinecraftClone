#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;

layout(max_vertices = 8, max_primitives = 12) out;
layout(triangles) out;

layout(push_constant) uniform PushConstants {
    mat4 projection_view;
    vec4 origin;
    vec4 extent;
    vec4 color;
} pc;

layout(location = 0) out vec4 outColor[];

const vec3 kCubeVertices[8] = vec3[](
    vec3(0,0,0), vec3(1,0,0), vec3(1,1,0), vec3(0,1,0),
    vec3(0,0,1), vec3(1,1,1), vec3(1,0,1), vec3(0,1,1)
);

const uvec3 kCubeTriangles[12] = uvec3[](
    uvec3(0,2,1), uvec3(0,3,2), uvec3(4,6,5), uvec3(4,5,7),
    uvec3(0,1,6), uvec3(0,6,4), uvec3(3,7,5), uvec3(3,5,2),
    uvec3(0,4,7), uvec3(0,7,3), uvec3(1,2,5), uvec3(1,5,6)
);

void main() {
    SetMeshOutputsEXT(8, 12);
    for (uint index = 0; index < 8; ++index) {
        vec3 world = pc.origin.xyz + pc.extent.xyz * kCubeVertices[index];
        gl_MeshVerticesEXT[index].gl_Position = pc.projection_view * vec4(world, 1.0);
        outColor[index] = pc.color;
    }
    for (uint index = 0; index < 12; ++index) {
        gl_PrimitiveTriangleIndicesEXT[index] = kCubeTriangles[index];
    }
}
