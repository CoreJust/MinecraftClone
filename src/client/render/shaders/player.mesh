#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;

layout(max_vertices = 4, max_primitives = 2) out;
layout(triangles) out;

layout(push_constant) uniform PushConstants {
    vec2 origin;
    float size;
    float pad0;
    vec4 color;
} pc;

layout(location = 0) out vec4 outColor[];

vec2 worldToNdc(vec2 p) {
    vec2 ndc;
    ndc.x = (p.x / 32.0) * 2.0 - 1.0;
    ndc.y = (p.y / 32.0) * 2.0 - 1.0;
    return ndc;
}

void main() {
    SetMeshOutputsEXT(4, 2);

    vec2 p0 = worldToNdc(pc.origin);
    vec2 p1 = worldToNdc(pc.origin + vec2(pc.size, 0.0));
    vec2 p2 = worldToNdc(pc.origin + vec2(0.0, pc.size));
    vec2 p3 = worldToNdc(pc.origin + vec2(pc.size, pc.size));

    gl_MeshVerticesEXT[0].gl_Position = vec4(p0, 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(p1, 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(p2, 0.0, 1.0);
    gl_MeshVerticesEXT[3].gl_Position = vec4(p3, 0.0, 1.0);

    outColor[0] = pc.color;
    outColor[1] = pc.color;
    outColor[2] = pc.color;
    outColor[3] = pc.color;

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(2, 1, 3);
}
