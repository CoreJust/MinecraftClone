set(test_root "@MC_TEST_BINARY_DIR@/corecpp-provenance")
set(fixture_root "@MC_CORECPP_PROVENANCE_FIXTURE_DIR@")
file(MAKE_DIRECTORY "${test_root}")
file(COPY_FILE
    "@MC_PROJECT_SOURCE_DIR@/dependencies.lock.json"
    "${fixture_root}/dependencies.lock.json"
)
file(READ "${fixture_root}/dependencies.lock.json" lock_json)
string(JSON locked_revision GET "${lock_json}" dependencies CoreCpp revision)
string(JSON lock_json SET "${lock_json}" dependencies CoreCpp fetch_ref "\"refs/tags/fixture-release\"")
file(WRITE "${fixture_root}/dependencies.lock.json" "${lock_json}")

execute_process(
    COMMAND "@MC_CMAKE_COMMAND@"
        -S "${fixture_root}"
        -B "${test_root}/exact"
        "-DCoreCpp_REVISION=${locked_revision}"
    RESULT_VARIABLE exact_result
    OUTPUT_VARIABLE exact_stdout
    ERROR_VARIABLE exact_stderr
)
if(NOT exact_result EQUAL 0)
    message(FATAL_ERROR "Current locked CoreCpp provenance was rejected:\n${exact_stdout}${exact_stderr}")
endif()

set(mismatch_revision "0000000000000000000000000000000000000000")
if(mismatch_revision STREQUAL locked_revision)
    set(mismatch_revision "1111111111111111111111111111111111111111")
endif()
execute_process(
    COMMAND "@MC_CMAKE_COMMAND@"
        -S "${fixture_root}"
        -B "${test_root}/mismatch"
        "-DCoreCpp_REVISION=${mismatch_revision}"
    RESULT_VARIABLE mismatch_result
    OUTPUT_VARIABLE mismatch_stdout
    ERROR_VARIABLE mismatch_stderr
)
if(mismatch_result EQUAL 0)
    message(FATAL_ERROR "MinecraftClone accepted a mismatched CoreCpp revision")
endif()
string(FIND "${mismatch_stdout}${mismatch_stderr}" "CoreCpp revision mismatch" mismatch_index)
if(mismatch_index EQUAL -1)
    message(FATAL_ERROR "Mismatched revision failed for an unexpected reason:\n${mismatch_stdout}${mismatch_stderr}")
endif()

execute_process(
    COMMAND "@MC_CMAKE_COMMAND@"
        -S "${fixture_root}"
        -B "${test_root}/mismatch-inexact"
        "-DCoreCpp_REVISION=${mismatch_revision}"
        -DMC_ALLOW_INEXACT_CORECPP=ON
    RESULT_VARIABLE inexact_result
    OUTPUT_VARIABLE inexact_stdout
    ERROR_VARIABLE inexact_stderr
)
if(inexact_result EQUAL 0)
    message(FATAL_ERROR "The legacy inexact flag bypassed the locked CoreCpp revision")
endif()
string(FIND "${inexact_stdout}${inexact_stderr}" "CoreCpp revision mismatch" inexact_index)
if(inexact_index EQUAL -1)
    message(FATAL_ERROR "Inexact override failed for an unexpected reason:\n${inexact_stdout}${inexact_stderr}")
endif()

foreach(invalid_ref IN ITEMS "refs/heads/ai-main" "refs/tags/a..b" "refs/tags/a.lock" "refs/tags/a/" "refs/tags/a//b" "refs/tags/a/.b")
    string(JSON invalid_lock SET "${lock_json}" dependencies CoreCpp fetch_ref "\"${invalid_ref}\"")
    file(WRITE "${fixture_root}/dependencies.lock.json" "${invalid_lock}")
    foreach(allow_inexact IN ITEMS OFF ON)
        execute_process(
            COMMAND "@MC_CMAKE_COMMAND@" -S "${fixture_root}" -B "${test_root}/invalid"
                "-DCoreCpp_REVISION=${locked_revision}" "-DMC_ALLOW_INEXACT_CORECPP=${allow_inexact}"
            RESULT_VARIABLE invalid_result OUTPUT_VARIABLE invalid_stdout ERROR_VARIABLE invalid_stderr
        )
        if(invalid_result EQUAL 0 OR NOT "${invalid_stdout}${invalid_stderr}" MATCHES "safe full refs/tags/")
            message(FATAL_ERROR "Unsafe CoreCpp ref ${invalid_ref} was not rejected: ${invalid_stdout}${invalid_stderr}")
        endif()
    endforeach()
endforeach()
file(WRITE "${fixture_root}/dependencies.lock.json" "${lock_json}")
