set(test_root "@MC_TEST_BINARY_DIR@/corecpp-server-consumer")
set(corecpp_prefix "@MC_CORECPP_DIR@/../../..")
set(dependency_prefix "@MC_CMAKE_PREFIX_PATH@")
if(NOT DEFINED MC_TEST_CONFIGURATION)
    set(MC_TEST_CONFIGURATION "@CMAKE_BUILD_TYPE@")
endif()

file(REMOVE_RECURSE "${test_root}")
file(MAKE_DIRECTORY "${test_root}")

set(mismatched_corecpp "${test_root}/mismatched-corecpp")
file(MAKE_DIRECTORY "${mismatched_corecpp}")
file(
    WRITE "${mismatched_corecpp}/CoreCppConfig.cmake"
    "set(CoreCpp_REVISION \"0000000000000000000000000000000000000000\")\n"
    "set(CoreCpp_DIRTY FALSE)\n"
    "set(CoreCpp_REVISION_EXACT TRUE)\n"
    "set(CoreCpp_AVAILABLE_COMPONENTS \"Core;Runtime\")\n"
    "add_library(CoreCpp::Core INTERFACE IMPORTED)\n"
    "add_library(CoreCpp::Runtime INTERFACE IMPORTED)\n"
    "set(CoreCpp_Core_FOUND TRUE)\n"
    "set(CoreCpp_Runtime_FOUND TRUE)\n"
    "set(CoreCpp_FOUND TRUE)\n"
)
execute_process(
    COMMAND
        "@MC_CMAKE_COMMAND@"
        -S "@MC_PROJECT_SOURCE_DIR@"
        -B "${test_root}/mismatch-build"
        -DCoreCpp_DIR=${mismatched_corecpp}
        -DBUILD_TESTING=OFF
        -DVCPKG_MANIFEST_INSTALL=OFF
    RESULT_VARIABLE mismatch_result
    OUTPUT_VARIABLE mismatch_output
    ERROR_VARIABLE mismatch_error
)
if(mismatch_result EQUAL 0)
    message(FATAL_ERROR "MinecraftClone accepted a mismatched CoreCpp revision")
endif()
string(CONCAT mismatch_log "${mismatch_output}" "${mismatch_error}")
if(NOT mismatch_log MATCHES "CoreCpp revision mismatch")
    message(FATAL_ERROR "CoreCpp mismatch failed for an unexpected reason:\n${mismatch_log}")
endif()

execute_process(
    COMMAND
        "@MC_CMAKE_COMMAND@"
        -S "@MC_PROJECT_SOURCE_DIR@/cmake/fixtures/corecpp_server_consumer"
        -B "${test_root}/build"
        "-DCMAKE_PREFIX_PATH=${corecpp_prefix};${dependency_prefix}"
        -DVCPKG_MANIFEST_INSTALL=OFF
        "-DCMAKE_BUILD_TYPE=${MC_TEST_CONFIGURATION}"
    RESULT_VARIABLE configure_result
    OUTPUT_VARIABLE configure_output
    ERROR_VARIABLE configure_error
)
if(NOT configure_result EQUAL 0)
    string(CONCAT configure_log "${configure_output}" "${configure_error}")
    message(FATAL_ERROR "CoreCpp server-only consumer configure failed:\n${configure_log}")
endif()

file(
    STRINGS "${test_root}/build/CMakeCache.txt" nested_configuration_types
    REGEX "^CMAKE_CONFIGURATION_TYPES:.*="
)
set(nested_is_multi_config FALSE)
if(nested_configuration_types)
    if(MC_TEST_CONFIGURATION STREQUAL "")
        message(FATAL_ERROR "Nested multi-config consumer requires an enclosing test configuration")
    endif()
    set(nested_is_multi_config TRUE)
endif()

set(build_command "@MC_CMAKE_COMMAND@" --build "${test_root}/build" --parallel 2)
if(nested_is_multi_config)
    list(APPEND build_command --config "${MC_TEST_CONFIGURATION}")
endif()
execute_process(
    COMMAND ${build_command}
    RESULT_VARIABLE build_result
    OUTPUT_VARIABLE build_output
    ERROR_VARIABLE build_error
)
if(NOT build_result EQUAL 0)
    string(CONCAT build_log "${build_output}" "${build_error}")
    message(FATAL_ERROR "CoreCpp server-only consumer build failed:\n${build_log}")
endif()

set(consumer_directory "${test_root}/build")
if(nested_is_multi_config)
    set(consumer_directory "${consumer_directory}/${MC_TEST_CONFIGURATION}")
endif()
if(WIN32)
    set(consumer_executable "${consumer_directory}/mc_corecpp_server_consumer.exe")
else()
    set(consumer_executable "${consumer_directory}/mc_corecpp_server_consumer")
endif()

execute_process(
    COMMAND "${consumer_executable}"
    WORKING_DIRECTORY "${test_root}"
    RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
    message(FATAL_ERROR "CoreCpp server-only consumer exited with ${run_result}")
endif()
